{
  "name": "pi-stickybar",
  "version": "3.0.0",
  "description": "Configurable two-line status bar for pi coding agent",
  "repository": {
    "type": "git",
    "url": "https://github.com/jekatigr/pi-stickybar"
  },
  "type": "module",
  "files": [
    "src/**/*.ts",
    "README.md",
    "*.json",
    "!progress.md"
  ],
  "keywords": [
    "pi-package",
    "pi",
    "coding-agent",
    "stickybar",
    "status-bar",
    "extension"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node --experimental-strip-types --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "^0.80.6",
    "@earendil-works/pi-coding-agent": "^0.80.6",
    "@earendil-works/pi-tui": "^0.80.6"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.0",
    "@earendil-works/pi-coding-agent": "^0.84.0",
    "@earendil-works/pi-tui": "^0.84.0",
    "@types/node": "^24.12.4",
    "typescript": "^5.9.3"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/jekatigr//pi-stickybar/main/docs/preview.gif"
  }
}
